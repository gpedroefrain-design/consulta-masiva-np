# Copie este archivo como .env (nunca lo suba al repositorio) y complete los valores.
# Clave aleatoria de al menos 32 caracteres para firmar la sesion.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# true (defecto y recomendado): se exige APP_ACCESS_PASSWORD.
# false: SIN contrasena, solo para piloto local en este equipo. Exige HOST de loopback
#   (127.0.0.1, ::1 o localhost) y rechaza peticiones que no vengan de loopback.
#   Riesgo: cualquier usuario/proceso del equipo puede usar la API con estas credenciales.
#   Nunca use false en un servidor compartido ni detras de un proxy.
APP_REQUIRE_LOGIN=true
# Contrasena compartida de acceso (minimo 12 caracteres). Provisional: no reemplaza SSO.
# Obligatoria si APP_REQUIRE_LOGIN=true; se ignora si es false.
APP_ACCESS_PASSWORD=
# true en produccion (HTTPS). Solo para pruebas locales en http://127.0.0.1 use false.
APP_COOKIE_SECURE=true

# Credenciales de la API (solo en el servidor; nunca en el navegador ni en el repositorio).
TDX_USERNAME=
TDX_PASSWORD=
TDX_CLI_ID=
TDX_LOGIN_URL=https://auth.dicexapis.com/v1/login/access_token
TDX_QUERY_URL=https://tdx4.dicexapis.com/jit/numeros_parte/masivo

# Limites
MAX_UPLOAD_MB=10
MAX_FILAS_NP=50000
TIEMPO_MAXIMO_SEGUNDOS=600
MAX_CONSULTAS_SIMULTANEAS=2

HOST=127.0.0.1
PORT=8000
# true solo si la app escucha en loopback detras de un proxy local que reemplaza X-Forwarded-For.
APP_TRUST_PROXY=false