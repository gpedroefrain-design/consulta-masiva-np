server {
    listen 80 default_server;
    server_name @PUBLIC_IPV4@;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://@PUBLIC_IPV4@$request_uri;
    }
}
